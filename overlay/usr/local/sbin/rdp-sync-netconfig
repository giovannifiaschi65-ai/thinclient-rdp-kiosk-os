#!/bin/bash
# Sincronizza i profili di rete NetworkManager (Ethernet, Wi-Fi, IP Statici, DNS)
# e le associazioni Bluetooth (/var/lib/bluetooth) su tutte le destinazioni persistenti
# disponibili (Disco Interno, Rufus FAT32/persistence e partizione dedicata RDPOS_CFG).

set -uo pipefail

if [ "$(id -u)" -ne 0 ]; then
    exit 1
fi

NM_DIR="/etc/NetworkManager/system-connections"
BT_DIR="/var/lib/bluetooth"
mkdir -p "$NM_DIR" "$BT_DIR" "/var/lib/rdp-kiosk"

TMP_NET="/var/lib/rdp-kiosk/net-profiles.tar.tmp.$$"
FINAL_NET="/var/lib/rdp-kiosk/net-profiles.tar"
HAVE_NET=0
if tar -cf "$TMP_NET" -C "$NM_DIR" . 2>/dev/null; then
    chmod 0600 "$TMP_NET"
    mv -f "$TMP_NET" "$FINAL_NET"
    HAVE_NET=1
else
    rm -f "$TMP_NET" 2>/dev/null || true
fi

TMP_BT="/var/lib/rdp-kiosk/bt-profiles.tar.tmp.$$"
FINAL_BT="/var/lib/rdp-kiosk/bt-profiles.tar"
HAVE_BT=0
if tar -cf "$TMP_BT" -C "$BT_DIR" . 2>/dev/null; then
    chmod 0600 "$TMP_BT"
    mv -f "$TMP_BT" "$FINAL_BT"
    HAVE_BT=1
else
    rm -f "$TMP_BT" 2>/dev/null || true
fi

copy_archives_to_dir() {
    local dest_dir="$1"
    if [ "$HAVE_NET" -eq 1 ]; then
        local tmp_n="${dest_dir}/net-profiles.tar.tmp.$$"
        if cp -f "$FINAL_NET" "$tmp_n" 2>/dev/null; then
            mv -f "$tmp_n" "${dest_dir}/net-profiles.tar" 2>/dev/null || true
        fi
    fi
    if [ "$HAVE_BT" -eq 1 ]; then
        local tmp_b="${dest_dir}/bt-profiles.tar.tmp.$$"
        if cp -f "$FINAL_BT" "$tmp_b" 2>/dev/null; then
            mv -f "$tmp_b" "${dest_dir}/bt-profiles.tar" 2>/dev/null || true
        fi
    fi
}

# 1. Salva sulla partizione dedicata RDPOS_CFG (Rufus DD / BalenaEtcher / ISO ibrida)
CFG_DEV="$(blkid -L RDPOS_CFG 2>/dev/null | head -n1 || true)"
if [ -n "$CFG_DEV" ] && [ -b "$CFG_DEV" ]; then
    CFG_MNT="/mnt/rdpos_cfg_net_rw"
    mkdir -p "$CFG_MNT"
    if mount -o rw,nosuid,nodev,noexec "$CFG_DEV" "$CFG_MNT" 2>/dev/null; then
        copy_archives_to_dir "$CFG_MNT"
        sync
        umount "$CFG_MNT" 2>/dev/null || true
    fi
    rmdir "$CFG_MNT" 2>/dev/null || true
fi

# 2. Salva su Disco Interno installato (ext4) o Chiavetta USB Rufus in modalità ISO (FAT32)
for medium in /run/live/medium /lib/live/mount/medium; do
    if mountpoint -q "$medium" 2>/dev/null; then
        fstype="$(findmnt -n -o FSTYPE "$medium" 2>/dev/null || true)"
        case "$fstype" in
            iso9660|udf|squashfs)
                continue
                ;;
        esac

        was_ro=0
        opts="$(findmnt -n -o OPTIONS "$medium" 2>/dev/null || true)"
        if echo ",${opts}," | grep -q ",ro,"; then
            was_ro=1
            mount -o remount,rw "$medium" 2>/dev/null || continue
        fi

        copy_archives_to_dir "$medium"
        sync

        if [ "$was_ro" -eq 1 ]; then
            mount -o remount,ro "$medium" 2>/dev/null || true
        fi
        break
    fi
done

exit 0
