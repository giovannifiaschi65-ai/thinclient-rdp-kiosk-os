#!/usr/bin/env python3
"""
Helper privilegiato per la gestione della rete (Ethernet + Wi-Fi + IPv4 DHCP/Statico/DNS)
tramite NetworkManager (nmcli) e salvataggio persistente su USB/Disco.
"""

import ipaddress
import json
import os
import subprocess
import sys
from pathlib import Path


def run_cmd(args: list[str], timeout: int = 25) -> subprocess.CompletedProcess:
    return subprocess.run(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
        check=False,
    )


def split_nmcli_terse(line: str) -> list[str]:
    """Divide una riga 'nmcli -t' gestendo il carattere di escape '\\:'."""
    out: list[str] = []
    cur: list[str] = []
    escaped = False
    for ch in line:
        if escaped:
            cur.append(ch)
            escaped = False
        elif ch == "\\":
            escaped = True
        elif ch == ":":
            out.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    out.append("".join(cur))
    return out


def parse_prefix(mask_or_prefix: str) -> int:
    val = mask_or_prefix.strip().lstrip("/")
    if not val:
        return 24
    if val.isdigit():
        plen = int(val)
        if not (1 <= plen <= 32):
            raise ValueError("Prefisso di rete non valido (usa 1-32 o es. 255.255.255.0).")
        return plen
    try:
        net = ipaddress.IPv4Network(f"0.0.0.0/{val}", strict=False)
        return net.prefixlen
    except Exception as exc:
        raise ValueError("Subnet Mask non valida (es. 255.255.255.0 oppure 24).") from exc


def prefix_to_netmask(plen: int) -> str:
    return str(ipaddress.IPv4Network(f"0.0.0.0/{plen}").netmask)


def get_interfaces() -> dict:
    run_cmd(["rfkill", "unblock", "wifi"], timeout=5)
    proc = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"])
    eth_devs = []
    wifi_devs = []
    active_wifi_ssid = ""

    for line in (proc.stdout or "").splitlines():
        parts = split_nmcli_terse(line)
        if len(parts) < 4:
            continue
        dev, dtype, state, conn = parts[0], parts[1], parts[2], parts[3]
        if dtype == "ethernet":
            eth_devs.append({"device": dev, "state": state, "connection": conn})
        elif dtype == "wifi":
            wifi_devs.append({"device": dev, "state": state, "connection": conn})

    if wifi_devs:
        wproc = run_cmd(["nmcli", "-t", "-f", "ACTIVE,SSID", "dev", "wifi"])
        for line in (wproc.stdout or "").splitlines():
            parts = split_nmcli_terse(line)
            if len(parts) >= 2 and parts[0] == "yes":
                active_wifi_ssid = parts[1]
                break

    return {
        "ok": True,
        "ethernet": eth_devs,
        "wifi": wifi_devs,
        "active_wifi_ssid": active_wifi_ssid,
    }


def scan_wifi(rescan: bool = True) -> dict:
    run_cmd(["rfkill", "unblock", "wifi"], timeout=5)
    run_cmd(["nmcli", "radio", "wifi", "on"], timeout=5)
    args = ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"]
    if rescan:
        args.extend(["--rescan", "yes"])
    proc = run_cmd(args, timeout=15)

    seen: dict[str, dict] = {}
    for line in (proc.stdout or "").splitlines():
        parts = split_nmcli_terse(line)
        if len(parts) < 4:
            continue
        in_use = parts[0].strip() == "*"
        ssid = parts[1].strip()
        if not ssid:
            continue
        try:
            sig = int(parts[2].strip())
        except ValueError:
            sig = 0
        sec = parts[3].strip()
        is_secure = bool(sec and sec != "--")
        existing = seen.get(ssid)
        if existing is None or in_use or sig > existing["signal"]:
            seen[ssid] = {
                "ssid": ssid,
                "signal": sig,
                "security": sec if is_secure else "Aperta",
                "secured": is_secure,
                "active": in_use or (existing["active"] if existing else False),
            }

    networks = sorted(
        seen.values(), key=lambda x: (not x["active"], -x["signal"], x["ssid"].lower())
    )
    return {"ok": True, "networks": networks}


def read_connection_ipv4(conn_name: str, dev_name: str) -> dict:
    info = {
        "method": "dhcp",
        "ip": "",
        "netmask": "255.255.255.0",
        "gateway": "",
        "dns": "",
    }
    if conn_name:
        proc = run_cmd(
            [
                "nmcli",
                "-t",
                "-f",
                "ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns",
                "connection",
                "show",
                conn_name,
            ],
            timeout=6,
        )
        kv = {}
        for line in (proc.stdout or "").splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                kv[k.strip()] = v.strip()
        if kv.get("ipv4.method") == "manual":
            info["method"] = "manual"
        addr_raw = kv.get("ipv4.addresses", "").split(",")[0].strip()
        if "/" in addr_raw:
            ip_part, plen_part = addr_raw.split("/", 1)
            info["ip"] = ip_part.strip()
            try:
                info["netmask"] = prefix_to_netmask(int(plen_part.strip()))
            except Exception:
                pass
        gw = kv.get("ipv4.gateway", "").strip()
        if gw and gw != "--":
            info["gateway"] = gw
        dns = kv.get("ipv4.dns", "").strip()
        if dns:
            info["dns"] = dns.replace(",", ", ")

    # Se siamo in DHCP (o nessun IP statico salvato), mostra anche l'IP/GW/DNS attuali come riferimento
    if dev_name and not info["ip"]:
        dproc = run_cmd(
            [
                "nmcli",
                "-t",
                "-f",
                "IP4.ADDRESS,IP4.GATEWAY,IP4.DNS",
                "device",
                "show",
                dev_name,
            ],
            timeout=5,
        )
        live_dns = []
        for line in (dproc.stdout or "").splitlines():
            if ":" not in line:
                continue
            k, v = line.split(":", 1)
            v = v.strip()
            if k.startswith("IP4.ADDRESS") and "/" in v and not info["ip"]:
                ip_p, pl_p = v.split("/", 1)
                info["ip"] = ip_p.strip()
                try:
                    info["netmask"] = prefix_to_netmask(int(pl_p.strip()))
                except Exception:
                    pass
            elif k == "IP4.GATEWAY" and v and v != "--" and not info["gateway"]:
                info["gateway"] = v
            elif k.startswith("IP4.DNS") and v:
                live_dns.append(v)
        if live_dns and not info["dns"]:
            info["dns"] = ", ".join(live_dns)

    return {"ok": True, **info}


def find_existing_conn_for_device(dev_name: str, conn_type: str, ssid: str = "") -> str:
    proc = run_cmd(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show"], timeout=6)
    by_ssid_name = f"WiFi-{ssid}" if ssid else ""
    candidates = []
    for line in (proc.stdout or "").splitlines():
        parts = split_nmcli_terse(line)
        if len(parts) < 3:
            continue
        cname, ctype, cdev = parts[0], parts[1], parts[2]
        if conn_type == "ethernet" and ctype == "802-3-ethernet":
            if cdev == dev_name or cname == f"Kiosk-{dev_name}":
                return cname
            candidates.append(cname)
        elif conn_type == "wifi" and ctype == "802-11-wireless":
            if cname in (by_ssid_name, ssid):
                return cname
    return candidates[0] if (conn_type == "ethernet" and candidates) else ""


def validate_and_format_ipv4(payload: dict) -> tuple[str, str, str, str]:
    method = (payload.get("ipv4_method") or "dhcp").strip().lower()
    dns_raw = (payload.get("dns") or "").replace(";", ",").replace(" ", ",")
    dns_list = []
    for tok in dns_raw.split(","):
        tok = tok.strip()
        if not tok:
            continue
        try:
            ipaddress.IPv4Address(tok)
        except Exception as exc:
            raise ValueError(f"Indirizzo Server DNS non valido: {tok}") from exc
        dns_list.append(tok)
    dns_str = ",".join(dns_list)

    if method != "manual":
        return "auto", "", "", dns_str

    ip_str = (payload.get("ip") or "").strip()
    mask_str = (payload.get("netmask") or "24").strip()
    gw_str = (payload.get("gateway") or "").strip()

    if not ip_str:
        raise ValueError("Inserisci l'Indirizzo IP statico.")
    try:
        ipaddress.IPv4Address(ip_str)
    except Exception as exc:
        raise ValueError(f"Indirizzo IP non valido: {ip_str}") from exc

    plen = parse_prefix(mask_str)
    if gw_str:
        try:
            ipaddress.IPv4Address(gw_str)
        except Exception as exc:
            raise ValueError(f"Indirizzo Gateway non valido: {gw_str}") from exc

    return "manual", f"{ip_str}/{plen}", gw_str, dns_str


def apply_config(payload: dict) -> dict:
    mode = (payload.get("type") or "ethernet").strip().lower()
    dev = (payload.get("device") or "").strip()
    if not dev:
        return {"ok": False, "error": "Nessuna scheda di rete rilevata per questa modalità."}

    try:
        ipv4_method, addr_cidr, gw_str, dns_str = validate_and_format_ipv4(payload)
    except ValueError as exc:
        return {"ok": False, "error": str(exc)}

    if mode == "ethernet":
        conn_name = find_existing_conn_for_device(dev, "ethernet")
        if not conn_name:
            conn_name = f"Kiosk-{dev}"
            add_res = run_cmd(
                ["nmcli", "connection", "add", "type", "ethernet", "ifname", dev, "con-name", conn_name]
            )
            if add_res.returncode != 0:
                return {"ok": False, "error": (add_res.stderr or "Impossibile creare il profilo Ethernet.").strip()}

        mod_args = ["nmcli", "connection", "modify", conn_name, "connection.autoconnect", "yes"]
        if ipv4_method == "auto":
            mod_args += [
                "ipv4.method", "auto",
                "ipv4.addresses", "",
                "ipv4.gateway", "",
                "ipv4.dns", dns_str,
                "ipv4.ignore-auto-dns", "yes" if dns_str else "no",
            ]
        else:
            mod_args += [
                "ipv4.method", "manual",
                "ipv4.addresses", addr_cidr,
                "ipv4.gateway", gw_str,
                "ipv4.dns", dns_str,
                "ipv4.ignore-auto-dns", "yes" if dns_str else "no",
            ]

        mres = run_cmd(mod_args)
        if mres.returncode != 0:
            return {"ok": False, "error": (mres.stderr or "Errore modifica parametri IPv4.").strip()}

        ures = run_cmd(["nmcli", "--wait", "15", "connection", "up", conn_name, "ifname", dev], timeout=20)
        run_cmd(["/usr/local/sbin/rdp-sync-netconfig"], timeout=10)
        if ures.returncode != 0:
            return {
                "ok": True,
                "warning": "Profilo salvato (verrà attivato appena il cavo Ethernet sarà collegato).",
            }
        return {"ok": True}

    elif mode == "wifi":
        ssid = (payload.get("ssid") or "").strip()
        psk = payload.get("password") or ""
        secured = bool(payload.get("secured", True))
        if not ssid:
            return {"ok": False, "error": "Seleziona o inserisci il nome della rete Wi-Fi (SSID)."}

        run_cmd(["rfkill", "unblock", "wifi"], timeout=5)
        run_cmd(["nmcli", "radio", "wifi", "on"], timeout=5)

        conn_name = find_existing_conn_for_device(dev, "wifi", ssid=ssid)
        created_new = False
        if not conn_name:
            conn_name = f"WiFi-{ssid}"
            add_res = run_cmd(
                [
                    "nmcli", "connection", "add",
                    "type", "wifi",
                    "ifname", dev,
                    "con-name", conn_name,
                    "ssid", ssid,
                ]
            )
            if add_res.returncode != 0:
                return {"ok": False, "error": (add_res.stderr or "Impossibile creare il profilo Wi-Fi.").strip()}
            created_new = True

        mod_args = [
            "nmcli", "connection", "modify", conn_name,
            "connection.interface-name", "",
            "connection.autoconnect", "yes",
        ]
        if psk:
            mod_args += [
                "802-11-wireless-security.key-mgmt", "wpa-psk",
                "802-11-wireless-security.psk-flags", "0",
                "802-11-wireless-security.psk", psk,
            ]
        elif created_new and secured:
            run_cmd(["nmcli", "connection", "delete", conn_name], timeout=5)
            return {"ok": False, "error": f"Inserisci la password per la rete protetta '{ssid}'."}

        if ipv4_method == "auto":
            mod_args += [
                "ipv4.method", "auto",
                "ipv4.addresses", "",
                "ipv4.gateway", "",
                "ipv4.dns", dns_str,
                "ipv4.ignore-auto-dns", "yes" if dns_str else "no",
            ]
        else:
            mod_args += [
                "ipv4.method", "manual",
                "ipv4.addresses", addr_cidr,
                "ipv4.gateway", gw_str,
                "ipv4.dns", dns_str,
                "ipv4.ignore-auto-dns", "yes" if dns_str else "no",
            ]

        mres = run_cmd(mod_args)
        if mres.returncode != 0:
            if created_new:
                run_cmd(["nmcli", "connection", "delete", conn_name], timeout=5)
            return {"ok": False, "error": (mres.stderr or "Password Wi-Fi o parametri non validi.").strip()}

        ures = run_cmd(["nmcli", "--wait", "22", "connection", "up", conn_name, "ifname", dev], timeout=26)
        if ures.returncode != 0:
            err_txt = (ures.stderr or ures.stdout or "").strip()
            return {
                "ok": False,
                "error": f"Connessione a '{ssid}' non riuscita. Verifica la password Wi-Fi ({err_txt or 'errore autenticazione'}).",
            }

        # Assicura permessi 0600 root:root e sincronizza su USB/Disco
        nm_dir = Path("/etc/NetworkManager/system-connections")
        if nm_dir.is_dir():
            for f in nm_dir.iterdir():
                if f.is_file():
                    os.chown(f, 0, 0)
                    os.chmod(f, 0o600)
        run_cmd(["/usr/local/sbin/rdp-sync-netconfig"], timeout=10)
        return {"ok": True}

    return {"ok": False, "error": "Modalità di rete sconosciuta."}


def disconnect_wifi(dev: str) -> dict:
    if dev:
        run_cmd(["nmcli", "device", "disconnect", dev], timeout=8)
    return {"ok": True}


def main() -> None:
    if os.geteuid() != 0:
        print(json.dumps({"ok": False, "error": "Richiesti privilegi di root."}))
        sys.exit(1)

    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "interfaces":
        print(json.dumps(get_interfaces()))
    elif cmd == "scan-wifi":
        rescan = (sys.argv[2] != "0") if len(sys.argv) > 2 else True
        print(json.dumps(scan_wifi(rescan=rescan)))
    elif cmd == "get-ipv4":
        conn_name = sys.argv[2] if len(sys.argv) > 2 else ""
        dev_name = sys.argv[3] if len(sys.argv) > 3 else ""
        print(json.dumps(read_connection_ipv4(conn_name, dev_name)))
    elif cmd == "disconnect-wifi":
        dev_name = sys.argv[2] if len(sys.argv) > 2 else ""
        print(json.dumps(disconnect_wifi(dev_name)))
    elif cmd == "apply":
        raw = sys.stdin.read()
        payload = json.loads(raw or "{}")
        print(json.dumps(apply_config(payload)))
    else:
        print(json.dumps({"ok": False, "error": f"Comando non valido: {cmd}"}))
        sys.exit(2)


if __name__ == "__main__":
    main()
