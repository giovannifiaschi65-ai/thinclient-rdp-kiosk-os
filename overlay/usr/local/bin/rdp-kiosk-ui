        wifi_bar.pack_start(w_lbl, True, True, 0)

        self.wifi_scan_btn = Gtk.Button(label="↻ Cerca reti")
        self.wifi_scan_btn.get_style_context().add_class("btn-secondary")
        self.wifi_scan_btn.connect("clicked", lambda _w: self._refresh_wifi_scan(rescan=True))
        wifi_bar.pack_start(self.wifi_scan_btn, False, False, 0)

        self.wifi_disc_btn = Gtk.Button(label="Disconnetti")
        self.wifi_disc_btn.get_style_context().add_class("btn-danger")
        self.wifi_disc_btn.connect("clicked", lambda _w: self._on_disconnect_wifi())
        wifi_bar.pack_start(self.wifi_disc_btn, False, False, 0)
        self.wifi_section.pack_start(wifi_bar, False, False, 0)

        sc_win = Gtk.ScrolledWindow()
        sc_win.get_style_context().add_class("wifi-frame")
        sc_win.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
