    0,   # Chiusura pulita
    1,   # ERRINFO_RPC_INITIATED_DISCONNECT (disconnessione lato server)
    2,   # ERRINFO_RPC_INITIATED_LOGOFF (logoff amministrativo)
    11,  # ERRINFO_RPC_INITIATED_DISCONNECT_BY_USER (Utente -> Disconnetti)
    12,  # ERRINFO_LOGOFF_BY_USER (Utente -> Esci / Disconnetti sessione)
}

