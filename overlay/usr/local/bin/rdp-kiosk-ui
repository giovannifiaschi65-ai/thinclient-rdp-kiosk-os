        wifi_creds_grid.attach(self.wifi_psk_entry, 1, 1, 1, 1)
        self.wifi_section.pack_start(wifi_creds_grid, False, False, 0)

        vbox.pack_start(self.wifi_section, False, False, 0)

        # Configurazione IPv4 (comune a Ethernet e Wi-Fi)
        mode_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        m_lbl = Gtk.Label(label="Configurazione IPv4:")
        m_lbl.get_style_context().add_class("field-label")
        m_lbl.set_halign(Gtk.Align.START)
        mode_row.pack_start(m_lbl, False, False, 0)

        self.ipv4_mode_combo = Gtk.ComboBoxText()
        self.ipv4_mode_combo.append("dhcp", "Automatico (DHCP)")
        self.ipv4_mode_combo.append("manual", "Manuale (IP Statico)")
        self.ipv4_mode_combo.set_active_id("dhcp")
        self.ipv4_mode_combo.connect("changed", lambda _w: self._update_ipv4_fields_sensitivity())
        mode_row.pack_start(self.ipv4_mode_combo, True, True, 0)
        vbox.pack_start(mode_row, False, False, 0)

        ip_grid = Gtk.Grid(column_spacing=10, row_spacing=6)

        def _grid_lbl(txt: str) -> Gtk.Label:
            l_w = Gtk.Label(label=txt)
            l_w.get_style_context().add_class("field-label")
            l_w.set_halign(Gtk.Align.START)
            return l_w

        def _grid_entry(ph: str) -> Gtk.Entry:
            e_w = Gtk.Entry()
            e_w.get_style_context().add_class("kiosk-entry")
            e_w.set_placeholder_text(ph)
            e_w.set_hexpand(True)
            return e_w

        self.net_ip_entry = _grid_entry("es. 192.168.1.50")
        self.net_mask_entry = _grid_entry("es. 255.255.255.0 o 24")
        self.net_gw_entry = _grid_entry("es. 192.168.1.1")
        self.net_dns_entry = _grid_entry("es. 192.168.1.10, 8.8.8.8")

        ip_grid.attach(_grid_lbl("Indirizzo IP"), 0, 0, 1, 1)
        ip_grid.attach(_grid_lbl("Subnet Mask / Prefisso"), 1, 0, 1, 1)
        ip_grid.attach(self.net_ip_entry, 0, 1, 1, 1)
        ip_grid.attach(self.net_mask_entry, 1, 1, 1, 1)

        ip_grid.attach(_grid_lbl("Gateway"), 0, 2, 1, 1)
        ip_grid.attach(_grid_lbl("Server DNS (opzionale in DHCP)"), 1, 2, 1, 1)
        ip_grid.attach(self.net_gw_entry, 0, 3, 1, 1)
        ip_grid.attach(self.net_dns_entry, 1, 3, 1, 1)

        vbox.pack_start(ip_grid, False, False, 0)

        # Barra pulsanti salvataggio rete
        foot_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        close_btn = Gtk.Button(label="Chiudi")
        close_btn.get_style_context().add_class("btn-secondary")
        close_btn.connect("clicked", lambda _w: self.stack.set_visible_child_name("login"))
        foot_row.pack_start(close_btn, False, False, 0)

        f_spacer = Gtk.Box()
        foot_row.pack_start(f_spacer, True, True, 0)

        self.net_apply_btn = Gtk.Button(label="Applica e Salva")
        self.net_apply_btn.get_style_context().add_class("btn-connect")
        self.net_apply_btn.connect("clicked", lambda _w: self._on_apply_network())
        foot_row.pack_start(self.net_apply_btn, False, False, 0)

        vbox.pack_start(foot_row, False, False, 2)
        self._update_ipv4_fields_sensitivity()
        return vbox

    def _show_net_banner(self, msg: str, kind: str = "info", spinning: bool = False) -> None:
        ctx = self.net_banner_box.get_style_context()
        for c in ("alert-error", "alert-info", "alert-success"):
            ctx.remove_class(c)
        ctx.add_class(f"alert-{kind}")
        self.net_banner_lbl.set_text(msg)
        if spinning:
            self.net_spinner.show()
            self.net_spinner.start()
        else:
            self.net_spinner.stop()
            self.net_spinner.hide()
        self.net_banner_lbl.show()
        self.net_banner_box.show()

    def _hide_net_banner(self) -> None:
        self.net_spinner.stop()
        self.net_banner_box.hide()

    def _run_net_helper(self, args: list[str], stdin_data: str = "", timeout: int = 28) -> dict:
        try:
            proc = subprocess.run(
                ["sudo", "-n", "/usr/local/sbin/rdp-net-helper", *args],
                input=stdin_data if stdin_data else None,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=timeout,
                check=False,
            )
            out = (proc.stdout or "").strip()
            if out:
                return json.loads(out.splitlines()[-1])
            err = (proc.stderr or "").strip()
            return {"ok": False, "error": err or f"Errore helper di rete (codice {proc.returncode})."}
        except Exception as exc:
            return {"ok": False, "error": str(exc)}

    def _update_ipv4_fields_sensitivity(self) -> None:
        is_manual = self.ipv4_mode_combo.get_active_id() == "manual"
        self.net_ip_entry.set_sensitive(is_manual)
        self.net_mask_entry.set_sensitive(is_manual)
        self.net_gw_entry.set_sensitive(is_manual)
        self.net_dns_entry.set_sensitive(True)

    def _open_network_panel(self) -> None:
        if self.connecting:
            return
        self._hide_net_banner()
        self.stack.set_visible_child_name("network")

        def _load_init() -> None:
            res = self._run_net_helper(["interfaces"], timeout=8)
            self.eth_devices = res.get("ethernet", [])
            self.wifi_devices = res.get("wifi", [])
            active_ssid = res.get("active_wifi_ssid", "")

            # Se non c'è Ethernet attiva ma c'è Wi-Fi disponibile/attiva, apre direttamente Wi-Fi
            eth_online = any(d.get("state") == "connected" for d in self.eth_devices)
            prefer_mode = "wifi" if (not eth_online and self.wifi_devices) else "ethernet"
            GLib.idle_add(self._finish_open_network_panel, prefer_mode, active_ssid)

        threading.Thread(target=_load_init, daemon=True).start()

    def _finish_open_network_panel(self, prefer_mode: str, active_ssid: str) -> bool:
        if active_ssid and not self.wifi_ssid_entry.get_text().strip():
            self.wifi_ssid_entry.set_text(active_ssid)
        self._switch_net_tab(prefer_mode)
        return False

    def _switch_net_tab(self, mode: str) -> None:
        self.net_mode = mode
        for btn, is_active in (
            (self.tab_eth_btn, mode == "ethernet"),
            (self.tab_wifi_btn, mode == "wifi"),
        ):
            ctx = btn.get_style_context()
            ctx.remove_class("btn-tab")
            ctx.remove_class("btn-tab-active")
            ctx.add_class("btn-tab-active" if is_active else "btn-tab")

        if mode == "wifi":
            for child in self.wifi_section.get_children():
                child.show_all()
            self.wifi_section.show()
            if not self.wifi_devices:
                self._show_net_banner("Nessuna scheda Wi-Fi rilevata su questa postazione.", kind="error")
            else:
                self._refresh_wifi_scan(rescan=False)
        else:
            self.wifi_section.hide()
            if not self.eth_devices:
                self._show_net_banner("Nessuna scheda Ethernet rilevata.", kind="error")
            else:
                self._hide_net_banner()

        self._load_current_ipv4_async()

    def _load_current_ipv4_async(self) -> None:
        mode = self.net_mode
        devs = self.eth_devices if mode == "ethernet" else self.wifi_devices
        if not devs:
            return
        dev_info = devs[0]
        dev_name = dev_info.get("device", "")
        conn_name = dev_info.get("connection", "")
        if conn_name == "--":
            conn_name = ""
        if mode == "wifi" and not conn_name:
            ssid = self.wifi_ssid_entry.get_text().strip()
            if ssid:
                conn_name = f"WiFi-{ssid}"

        def _worker() -> None:
            info = self._run_net_helper(["get-ipv4", conn_name, dev_name], timeout=8)
            GLib.idle_add(self._populate_ipv4_fields, info)

        threading.Thread(target=_worker, daemon=True).start()

    def _populate_ipv4_fields(self, info: dict) -> bool:
        if not info.get("ok"):
            return False
        method = info.get("method", "dhcp")
        self.ipv4_mode_combo.set_active_id("manual" if method == "manual" else "dhcp")
        self.net_ip_entry.set_text(info.get("ip", ""))
        self.net_mask_entry.set_text(info.get("netmask", "255.255.255.0"))
        self.net_gw_entry.set_text(info.get("gateway", ""))
        self.net_dns_entry.set_text(info.get("dns", ""))
        self._update_ipv4_fields_sensitivity()
        return False

    def _refresh_wifi_scan(self, rescan: bool = True) -> None:
        if not self.wifi_devices or self.net_busy:
            return
        self._show_net_banner("Ricerca reti Wi-Fi in corso...", kind="info", spinning=True)

        def _scan_worker() -> None:
            res = self._run_net_helper(["scan-wifi", "1" if rescan else "0"], timeout=18)
            GLib.idle_add(self._populate_wifi_list, res)

        threading.Thread(target=_scan_worker, daemon=True).start()

    def _populate_wifi_list(self, res: dict) -> bool:
        for row in self.wifi_listbox.get_children():
            self.wifi_listbox.remove(row)
        self._hide_net_banner()

        if not res.get("ok"):
            self._show_net_banner(res.get("error", "Impossibile eseguire la scansione Wi-Fi."), kind="error")
            return False

        self.wifi_networks = res.get("networks", [])
        if not self.wifi_networks:
            placeholder = Gtk.Label(label="Nessuna rete Wi-Fi trovata. Premi 'Cerca reti'.")
            placeholder.get_style_context().add_class("wifi-row-label")
            self.wifi_listbox.add(placeholder)
            self.wifi_listbox.show_all()
            return False

        for net in self.wifi_networks:
            row = Gtk.ListBoxRow()
            row.wifi_data = net
            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            mark = "✓ " if net.get("active") else "   "
            lock = "🔒" if net.get("secured") else "🔓"
            ssid_lbl = Gtk.Label(label=f"{mark}{net['ssid']}")
            ssid_lbl.get_style_context().add_class("wifi-row-label")
            ssid_lbl.set_halign(Gtk.Align.START)
            hbox.pack_start(ssid_lbl, True, True, 0)

            meta_lbl = Gtk.Label(label=f"{net['signal']}%  {lock}")
            meta_lbl.get_style_context().add_class("wifi-row-label")
            hbox.pack_start(meta_lbl, False, False, 0)
            row.add(hbox)
            self.wifi_listbox.add(row)

        self.wifi_listbox.show_all()
        return False

    def _on_wifi_row_selected(self, _listbox: Gtk.ListBox, row: Gtk.ListBoxRow) -> None:
        if row is None or not hasattr(row, "wifi_data"):
            return
        data = row.wifi_data
        self.wifi_ssid_entry.set_text(data.get("ssid", ""))
        self.selected_wifi_secured = bool(data.get("secured", True))
        self.wifi_psk_entry.set_text("")
        if self.selected_wifi_secured:
            self.wifi_psk_entry.grab_focus()
        self._load_current_ipv4_async()

    def _on_disconnect_wifi(self) -> None:
        if not self.wifi_devices or self.net_busy:
            return
        dev = self.wifi_devices[0].get("device", "")
        self._show_net_banner("Disconnessione Wi-Fi in corso...", kind="info", spinning=True)

        def _disc() -> None:
            self._run_net_helper(["disconnect-wifi", dev], timeout=10)
            GLib.idle_add(self._on_wifi_disconnected)

        threading.Thread(target=_disc, daemon=True).start()

    def _on_wifi_disconnected(self) -> bool:
        self._show_net_banner("Wi-Fi disconnesso.", kind="info", spinning=False)
        self._trigger_status_poll()
        self._refresh_wifi_scan(rescan=False)
        return False

    def _on_apply_network(self) -> None:
        if self.net_busy:
            return
        devs = self.eth_devices if self.net_mode == "ethernet" else self.wifi_devices
        if not devs:
            self._show_net_banner("Nessuna scheda di rete disponibile per questa modalità.", kind="error")
            return

        payload = {
            "type": self.net_mode,
            "device": devs[0].get("device", ""),
            "ipv4_method": self.ipv4_mode_combo.get_active_id() or "dhcp",
            "ip": self.net_ip_entry.get_text().strip(),
            "netmask": self.net_mask_entry.get_text().strip() or "255.255.255.0",
            "gateway": self.net_gw_entry.get_text().strip(),
            "dns": self.net_dns_entry.get_text().strip(),
            "ssid": self.wifi_ssid_entry.get_text().strip(),
            "password": self.wifi_psk_entry.get_text(),
            "secured": self.selected_wifi_secured,
        }

        self.net_busy = True
        self.net_apply_btn.set_sensitive(False)
        self._show_net_banner(
            "Applicazione parametri di rete e salvataggio permanente in corso...",
            kind="info",
            spinning=True,
        )

        def _apply_worker() -> None:
            res = self._run_net_helper(["apply"], stdin_data=json.dumps(payload), timeout=30)
            GLib.idle_add(self._on_apply_network_finished, res)

        threading.Thread(target=_apply_worker, daemon=True).start()

    def _on_apply_network_finished(self, res: dict) -> bool:
        self.net_busy = False
        self.net_apply_btn.set_sensitive(True)
        self.wifi_psk_entry.set_text("")
        self._trigger_status_poll()

        if not res.get("ok"):
            self._show_net_banner(res.get("error", "Errore configurazione rete."), kind="error", spinning=False)
            return False

        warn = res.get("warning", "")
        msg = warn if warn else "Impostazioni di rete applicate e memorizzate con successo!"
        self._show_net_banner(msg, kind="success", spinning=False)
        return False

    def _prompt_power_action(self, action: str) -> None:
        if self.connecting:
            return
        self.pending_power_action = action
        if action == "reboot":
            self.confirm_title.set_text("Riavviare la postazione?")
            self.confirm_desc.set_text(
                "Il Thin Client verrà riavviato immediatamente e tornerà a questa schermata."
            )
            self.confirm_exec_btn.set_label("Riavvia ora")
        else:
            self.confirm_title.set_text("Spegnere la postazione?")
            self.confirm_desc.set_text(
                "Il Thin Client verrà arrestato completamente in sicurezza."
            )
            self.confirm_exec_btn.set_label("Spegni ora")
        self.stack.set_visible_child_name("confirm_power")
        self.confirm_exec_btn.grab_focus()

    def _execute_power_action(self) -> None:
        action = self.pending_power_action
        if action not in ("reboot", "poweroff"):
            return
        self.stack.set_visible_child_name("login")
        self._set_form_sensitive(False)
        if action == "reboot":
            self._show_banner("Riavvio del sistema in corso...", is_error=False, spinning=True)
        else:
            self._show_banner("Spegnimento del sistema in corso...", is_error=False, spinning=True)

        def _trigger_power() -> bool:
            proc = subprocess.run(
                ["sudo", "-n", "/usr/local/sbin/rdp-power-action", action],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
            )
            if proc.returncode != 0:
                fallback = subprocess.run(
                    ["/usr/bin/systemctl", action, "-i"],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    text=True,
                    check=False,
                )
                if fallback.returncode != 0:
                    self._set_form_sensitive(True)
                    err = (proc.stderr or fallback.stderr or "").strip()
                    self._show_banner(
                        f"Impossibile completare l'operazione ({err or 'permesso negato'}).",
                        is_error=True,
                        spinning=False,
                    )
            return False

        GLib.timeout_add(120, _trigger_power)

    def _update_status_bar(self) -> bool:
        now_str = datetime.datetime.now().strftime("%d/%m/%Y  %H:%M")
        self.clock_label.set_text(now_str)
        if not self.connecting:
            self._trigger_status_poll()
        return True

    def _trigger_status_poll(self) -> None:
        if self._status_polling:
            return
        self._status_polling = True

        def _poll_worker() -> None:
            try:
                net_state, net_text = get_network_status()
                sc_state, sc_text, sc_tip = get_smartcard_status()
                GLib.idle_add(self._apply_status_badges, net_state, net_text, sc_state, sc_text, sc_tip)
            finally:
                self._status_polling = False

        threading.Thread(target=_poll_worker, daemon=True).start()

    def _apply_status_badges(
        self, net_state: str, net_text: str, sc_state: str, sc_text: str, sc_tip: str
    ) -> bool:
        self.net_badge.set_text(net_text)
        n_ctx = self.net_badge.get_style_context()
        for cls in ("status-online", "status-waiting", "status-offline", "status-muted"):
            n_ctx.remove_class(cls)
        n_ctx.add_class(f"status-{net_state}")

        self.sc_badge.set_text(sc_text)
        self.sc_badge.set_tooltip_text(sc_tip)
        s_ctx = self.sc_badge.get_style_context()
        for cls in ("status-online", "status-waiting", "status-offline", "status-muted"):
            s_ctx.remove_class(cls)
        s_ctx.add_class(f"status-{sc_state}")
        return False

    def _show_banner(self, message: str, is_error: bool = True, spinning: bool = False) -> None:
        ctx = self.banner_box.get_style_context()
        ctx.remove_class("alert-error")
        ctx.remove_class("alert-info")
        ctx.add_class("alert-error" if is_error else "alert-info")

        self.banner_label.set_text(message)
        if spinning:
            self.spinner.show()
            self.spinner.start()
        else:
            self.spinner.stop()
            self.spinner.hide()

        self.banner_label.show()
        self.banner_box.show()

    def _hide_banner(self) -> None:
        self.spinner.stop()
        self.banner_box.hide()

    def _set_form_sensitive(self, enabled: bool) -> None:
        for widget in (
            self.server_entry,
            self.domain_entry,
            self.user_entry,
            self.pass_entry,
            self.connect_btn,
            self.clear_btn,
            self.reboot_btn,
            self.poweroff_btn,
            self.net_settings_btn,
        ):
            widget.set_sensitive(enabled)

    def _scrub_session_artifacts(self) -> None:
        """Pulisce gli appunti X11, sincronizza eventuali dischi USB e rimuove cache FreeRDP."""
        try:
            os.sync()
        except Exception:
            pass

        try:
            display = Gdk.Display.get_default()
            if display is not None:
                for atom_name in ("CLIPBOARD", "PRIMARY"):
                    cb = Gtk.Clipboard.get_for_display(display, Gdk.Atom.intern(atom_name, False))
                    cb.set_text("", -1)
                    cb.clear()
        except Exception:
            pass

        freerdp_cfg = Path.home() / ".config" / "freerdp"
        if freerdp_cfg.exists():
            shutil.rmtree(freerdp_cfg, ignore_errors=True)

    def clear_form_fields(self) -> None:
        """Svuota manualmente tutti i campi a schermo e azzera i dati memorizzati."""
        self._scrub_session_artifacts()
        self._hide_banner()
        self.config["default_server"] = ""
        self.config["default_domain"] = ""
        self.config["default_user"] = ""
        self.server_entry.set_text("")
        self.domain_entry.set_text("")
        self.user_entry.set_text("")
        self.pass_entry.set_text("")
        self.pass_entry.set_visibility(False)
        self.pass_entry.set_icon_from_icon_name(
            Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic"
        )
        threading.Thread(
            target=lambda: subprocess.run(
                ["sudo", "-n", "/usr/local/sbin/rdp-save-target", "", "", ""],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=8,
                check=False,
            ),
            daemon=True,
        ).start()
        self.server_entry.grab_focus()

    def reset_mask(self, initial: bool = False) -> None:
        """Ripristina la maschera: mantiene Server/Dominio/Utente memorizzati e azzera la Password."""
        self._scrub_session_artifacts()
        self._hide_banner()

        if self.config["clear_all_on_disconnect"] and not initial:
            self.server_entry.set_text("")
            self.domain_entry.set_text("")
            self.user_entry.set_text("")
        else:
            self.server_entry.set_text(self.config["default_server"])
            self.domain_entry.set_text(self.config["default_domain"])
            self.user_entry.set_text(self.config["default_user"])

        self.pass_entry.set_text("")
        self.pass_entry.set_visibility(False)
        self.pass_entry.set_icon_from_icon_name(
            Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic"
        )

        self.stack.set_visible_child_name("login")
        if not self.server_entry.get_text().strip():
            self.server_entry.grab_focus()
        elif not self.user_entry.get_text().strip():
            self.user_entry.grab_focus()
        else:
            self.pass_entry.grab_focus()

    def on_connect_clicked(self) -> None:
        if self.connecting:
            return

        server = self.server_entry.get_text().strip()
        domain = self.domain_entry.get_text().strip()
        username = self.user_entry.get_text().strip()
        password = self.pass_entry.get_text()

        # Nasconde sempre la password in chiaro prima di connettersi
        self.pass_entry.set_visibility(False)
        self.pass_entry.set_icon_from_icon_name(
            Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic"
        )

        # Validazione base dei campi
        if not server:
            self._show_banner("Inserisci l'indirizzo del Server Windows.", is_error=True)
            self.server_entry.grab_focus()
            return

        if server.startswith(("/", "-")) or any(ch.isspace() for ch in server):
            self._show_banner("Indirizzo Server Windows non valido.", is_error=True)
            self.server_entry.grab_focus()
            return

        if not username:
            self._show_banner("Inserisci il nome Utente Windows.", is_error=True)
            self.user_entry.grab_focus()
            return

        if username.startswith(("/", "-")):
            self._show_banner("Formato nome Utente non valido.", is_error=True)
            self.user_entry.grab_focus()
            return

        # Supporta formato DOMINIO\utente anche se inserito direttamente nel campo Utente
        if "\\" in username and not domain:
            parts = username.split("\\", 1)
            domain, username = parts[0].strip(), parts[1].strip()
            self.domain_entry.set_text(domain)
            self.user_entry.set_text(username)

        if domain and domain.startswith(("/", "-")):
            self._show_banner("Formato Dominio non valido.", is_error=True)
            self.domain_entry.grab_focus()
            return

        # Memorizza subito Server, Dominio e Utente in memoria (e su disco/USB nel thread di avvio)
        if not self.config["clear_all_on_disconnect"]:
            self.config["default_server"] = server
            self.config["default_domain"] = domain
            self.config["default_user"] = username

        if not password:
            self._show_banner("Inserisci la Password per l'autenticazione NLA.", is_error=True)
            self.pass_entry.grab_focus()
            return

        net_state, _ = get_network_status()
        if net_state != "online":
            self._show_banner(
                "Rete non connessa. Premi '⚙ Rete / Wi-Fi' in alto o verifica il cavo Ethernet.",
                is_error=True,
            )
            return

        self.connecting = True
        self._set_form_sensitive(False)
        self._show_banner(
            f"Connessione NLA a {server} in corso...", is_error=False, spinning=True
        )

        worker = threading.Thread(
            target=self._run_freerdp_session,
            args=(server, domain, username, password),
            daemon=True,
        )
        worker.start()

    def _build_freerdp_args(
        self, server: str, domain: str, username: str, password: str
    ) -> list[str]:
        kbd_flag = "/kbd:layout:0x00000410" if self.freerdp_v3 else "/kbd:0x00000410"
        args = [
            f"/v:{server}",
            f"/u:{username}",
            f"/p:{password}",
            "/sec:nla",
            "/cert:ignore",
            "/f",
            "-toggle-fullscreen",
            "/dynamic-resolution",
            "/network:auto",
            "+clipboard",
            "/sound",
            kbd_flag,
            "/title:Sessione Desktop Remoto",
        ]
        if domain:
            args.insert(2, f"/d:{domain}")

        if self.config.get("enable_usb_drives", True):
            args.append("/drive:hotplug,*")
        if self.config.get("enable_printers", True):
            args.append("/printer")
        if self.config.get("enable_smartcard", True):
            args.append("/smartcard")

        extra = self.config.get("extra_freerdp_args", "")
        if extra:
            try:
                args.extend([tok for tok in shlex.split(extra) if tok])
            except ValueError:
                pass
        return args

    def _persist_target_on_disk(self, server: str, domain: str, username: str) -> None:
        if self.config["clear_all_on_disconnect"]:
            return
        try:
            subprocess.run(
                ["sudo", "/usr/local/sbin/rdp-save-target", server, domain, username],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=6,
            )
        except Exception:
            pass

    def _run_freerdp_session(
        self, server: str, domain: str, username: str, password: str
    ) -> None:
        self._persist_target_on_disk(server, domain, username)
        if self.config.get("enable_printers", True):
            try:
                subprocess.run(
                    ["sudo", "/usr/local/sbin/kiosk-printer-autoconfig"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=8,
                )
            except Exception:
                pass
        rdp_args = self._build_freerdp_args(server, domain, username, password)
        started_at = time.monotonic()

        try:
            if self.supports_args_from:
                proc = subprocess.Popen(
                    [self.freerdp_bin, "/args-from:stdin"],
                    stdin=subprocess.PIPE,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    text=True,
                )
                stdin_payload = "\n".join(rdp_args) + "\n"
                _, stderr_data = proc.communicate(input=stdin_payload)
            else:
                proc = subprocess.Popen(
                    [self.freerdp_bin, *rdp_args],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    text=True,
                )
                _, stderr_data = proc.communicate()

            returncode = proc.returncode
        except FileNotFoundError:
            returncode = -1
            stderr_data = "Impossibile trovare il client FreeRDP installato."
        except Exception as exc:
            returncode = -1
            stderr_data = str(exc)

        elapsed = time.monotonic() - started_at
        GLib.idle_add(self._on_freerdp_finished, returncode, stderr_data or "", elapsed)

    def _on_freerdp_finished(
        self, returncode: int, stderr_data: str, elapsed_seconds: float
    ) -> bool:
        self.connecting = False
        self._set_form_sensitive(True)

        # Se la sessione si è chiusa normalmente (Disconnetti / Esci) o è durata oltre 15s,
        # torniamo sempre alla maschera completamente pulita per l'utente successivo.
        if returncode in NORMAL_EXIT_CODES or (returncode == 5):
            self.reset_mask(initial=False)
            if returncode == 5:
                self._show_banner(
                    "Sessione trasferita su un'altra postazione.", is_error=False
                )
        elif elapsed_seconds >= 15.0:
            self.reset_mask(initial=False)
            self._show_banner(
                "La sessione remota si è interrotta. È possibile riconnettersi.",
                is_error=True,
            )
        else:
            # Errore immediato in fase di connessione o autenticazione NLA:
            # azzera sempre la password per sicurezza e mostra il motivo in italiano.
            self._scrub_session_artifacts()
            self.pass_entry.set_text("")
            error_msg = (
                stderr_data
                if returncode == -1
                else translate_freerdp_error(returncode, stderr_data)
            )
            self._show_banner(error_msg, is_error=True)
            self.pass_entry.grab_focus()

        self.present()
        self.fullscreen()
        return False


def main() -> None:
    win = RdpKioskWindow()
    win.show_all()
    win._hide_banner()
    GLib.idle_add(lambda: (win.reset_mask(initial=True), False)[1])
    Gtk.main()


if __name__ == "__main__":
    main()
