        # Contenitore specifico Wi-Fi (visibile solo su scheda Wi-Fi)
        self.wifi_section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.wifi_section.set_no_show_all(True)

        wifi_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        w_lbl = Gtk.Label(label="Reti Wi-Fi rilevate")
        w_lbl.get_style_context().add_class("field-label")
