        self.wifi_ssid_entry = Gtk.Entry()
        self.wifi_ssid_entry.get_style_context().add_class("kiosk-entry")
        self.wifi_ssid_entry.set_placeholder_text("SSID rete Wi-Fi")
        self.wifi_ssid_entry.set_hexpand(True)

        self.wifi_psk_entry = Gtk.Entry()
        self.wifi_psk_entry.get_style_context().add_class("kiosk-entry")
        self.wifi_psk_entry.set_placeholder_text("Password (vuoto se già salvata/aperta)")
        self.wifi_psk_entry.set_hexpand(True)
        self.wifi_psk_entry.set_visibility(False)
        self.wifi_psk_entry.set_invisible_char("●")
        self.wifi_psk_entry.set_icon_from_icon_name(
