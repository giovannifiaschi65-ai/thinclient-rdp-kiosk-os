#!/bin/bash
# Sessione X11 minimale per Thin Client RDP Kiosk (zero desktop)
trap '' INT QUIT TSTP

export LANG=it_IT.UTF-8
export LC_ALL=it_IT.UTF-8
export GDK_BACKEND=x11
export NO_AT_BRIDGE=1

# Tastiera italiana su X11
setxkbmap -model pc105 -layout it 2>/dev/null || true

# Garanzia aggiuntiva runtime per Touchpad (Tap, Doppio Tap, Trascinamento e Scorrimento Naturale)
if command -v xinput >/dev/null 2>&1; then
    for dev_id in $(xinput list --id-only 2>/dev/null); do
        if xinput list-props "$dev_id" 2>/dev/null | grep -q "libinput Tapping Enabled ("; then
            xinput set-prop "$dev_id" "libinput Tapping Enabled" 1 2>/dev/null || true
            xinput set-prop "$dev_id" "libinput Tapping Drag Enabled" 1 2>/dev/null || true
            xinput set-prop "$dev_id" "libinput Tapping Drag Lock Enabled" 0 2>/dev/null || true
            xinput set-prop "$dev_id" "libinput Natural Scrolling Enabled" 1 2>/dev/null || true
            xinput set-prop "$dev_id" "libinput Disable While Typing Enabled" 1 2>/dev/null || true
        fi
    done
fi

# Sfondo uniforme scuro e cursore standard (nessuno sfarfallio grigio X11)
xsetroot -solid "#0f172a" 2>/dev/null || true
xsetroot -cursor_name left_ptr 2>/dev/null || true

# Disabilita salvaschermo X11
xset s off 2>/dev/null || true
xset s noblank 2>/dev/null || true
xset -dpms 2>/dev/null || true

# Avvia bus D-Bus di sessione se non già presente
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
    eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

# Avvia PulseAudio in background per il reindirizzamento audio e microfono RDP
if command -v pulseaudio >/dev/null 2>&1; then
    pulseaudio --start --exit-idle-time=-1 >/dev/null 2>&1 || true
fi

# Attiva e alza a livello ottimale uscita audio e microfono predefiniti (ALSA / PulseAudio)
if command -v amixer >/dev/null 2>&1; then
    amixer -q sset Master 85% unmute 2>/dev/null || true
    amixer -q sset Capture 85% cap 2>/dev/null || true
    amixer -q sset Mic 85% unmute cap 2>/dev/null || true
fi
if command -v pactl >/dev/null 2>&1; then
    pactl set-sink-mute @DEFAULT_SINK@ 0 2>/dev/null || true
    pactl set-source-mute @DEFAULT_SOURCE@ 0 2>/dev/null || true
    pactl set-source-volume @DEFAULT_SOURCE@ 85% 2>/dev/null || true
fi

# Avvia window manager minimale Openbox (senza decorazioni né scorciatoie)
openbox --config-file /etc/xdg/openbox/rc.xml >/tmp/openbox.log 2>&1 &
WM_PID=$!

# Ciclo di esecuzione dell'interfaccia Kiosk RDP
while [ ! -e /run/rdp-kiosk-powering-down ]; do
    /usr/local/bin/rdp-kiosk-ui
    [ -e /run/rdp-kiosk-powering-down ] && break
    sleep 0.5
done

kill "$WM_PID" 2>/dev/null || true
