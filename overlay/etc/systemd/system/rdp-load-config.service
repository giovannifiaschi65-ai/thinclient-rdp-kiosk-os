[Unit]
Description=Caricamento configurazione persistente Thin Client RDP, Rete/Wi-Fi e Bluetooth
DefaultDependencies=no
After=systemd-udevd.service local-fs.target
Before=NetworkManager.service NetworkManager-pre.target bluetooth.service getty@tty1.service
Wants=NetworkManager-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rdp-load-config

[Install]
WantedBy=multi-user.target NetworkManager.service bluetooth.service
