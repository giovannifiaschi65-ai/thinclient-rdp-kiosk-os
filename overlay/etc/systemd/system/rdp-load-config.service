[Unit]
Description=Caricamento configurazione persistente Thin Client RDP da USB (RDPOS_CFG)
DefaultDependencies=no
After=systemd-udevd.service local-fs.target
Before=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rdp-load-config

[Install]
WantedBy=multi-user.target
